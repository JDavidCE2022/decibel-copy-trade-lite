# Copia este archivo a ".env" y rellena los valores reales.
# El archivo ".env" nunca se sube a git (ver .gitignore).

# Clave privada de una cuenta de TESTNET (nunca de mainnet, nunca con fondos reales).
PRIVATE_KEY=

# API key gratuita de Aptos Labs (build.aptoslabs.com) para no ser bloqueado
# como request anónimo al leer datos de testnet.
APTOS_NODE_API_KEY=
