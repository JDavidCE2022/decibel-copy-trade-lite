# Copy this file to ".env" and fill in the real values.
# The ".env" file is never pushed to git (see .gitignore).

# Private key for a TESTNET account (never mainnet, never with real funds).
PRIVATE_KEY=

# Free Aptos Labs API key (build.aptoslabs.com) so you don't get rate-limited
# as an anonymous request when reading testnet data.
APTOS_NODE_API_KEY=
